# Copy to .env and adjust.

# Local default: SQLite file. docker-compose overrides this with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./reports.db

# "fake" needs no API key. Switch to "openai" to call a real model.
LLM_PROVIDER=fake

# Any OpenAI-compatible endpoint works (OpenAI, Mistral, a local Ollama server, ...).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
